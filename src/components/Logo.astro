---
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: className = '', compact = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    class="h-9 w-9 shrink-0"
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="ac-grad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FFD166"></stop>
        <stop offset="0.55" stop-color="#F5A300"></stop>
        <stop offset="1" stop-color="#FF7A18"></stop>
      </linearGradient>
    </defs>
    <path d="M20 3 7 34h6.4l2.3-6h8.6l2.3 6H33L20 3Zm0 11.6 2.9 7.6h-5.8l2.9-7.6Z" fill="url(#ac-grad)"></path>
    <path d="M4 34h32" stroke="#38D1EC" stroke-width="2" stroke-linecap="round" opacity=".9"></path>
  </svg>
  {
    !compact && (
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-extrabold tracking-tight text-ink-50">
          ART<span class="text-amber-400">CONTENT</span>
        </span>
        <span class="mt-1 text-[10px] font-semibold tracking-[0.18em] text-ink-300 uppercase">Agenzia ZAlight · ER & Marche</span>
      </span>
    )
  }
</span>
