---
import Logo from './Logo.astro';
import { nav, site } from '../config/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur-md supports-[backdrop-filter]:bg-ink-950/65"
>
  <div class="container-x flex h-16 items-center justify-between gap-6 lg:h-[72px]">
    <a href="/" class="shrink-0 rounded-md" title="Torna alla home">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigazione principale">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-2 text-[13px] font-medium whitespace-nowrap transition-colors xl:px-3.5 xl:text-sm',
              isActive(item.href) ? 'bg-white/8 text-ink-50' : 'text-ink-200 hover:bg-white/5 hover:text-ink-50',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={`mailto:${site.email}`} class="btn-ghost hidden text-sm whitespace-nowrap 2xl:inline-flex" aria-label="Scrivi email">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        {site.email}
      </a>
      <a href="/contatti" class="btn-primary hidden px-5 py-2.5 whitespace-nowrap sm:inline-flex">Richiedi consulenza</a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-ink-100 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Apri menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path class="menu-icon-open" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          <path class="menu-icon-close hidden" d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/5 bg-ink-950/95 lg:hidden" hidden>
    <nav class="container-x flex flex-col gap-1 py-4" aria-label="Navigazione mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-xl px-4 py-3 text-base font-medium',
              isActive(item.href) ? 'bg-white/8 text-ink-50' : 'text-ink-200 hover:bg-white/5',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2 border-t border-white/5 pt-4">
        <a href="/contatti" class="btn-primary w-full">Richiedi consulenza</a>
        <a href={`mailto:${site.email}`} class="btn-secondary w-full">{site.email}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const iconOpen = toggle.querySelector('.menu-icon-open');
    const iconClose = toggle.querySelector('.menu-icon-close');
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      menu.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);
    };
    toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
