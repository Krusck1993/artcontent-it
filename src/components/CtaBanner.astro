---
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  compact?: boolean;
}
const {
  title = 'Parliamo del tuo prossimo progetto luce',
  description = 'Sopralluogo, demo dei prodotti, scelta della configurazione e preventivo: un unico interlocutore tecnico-commerciale per Emilia-Romagna e Marche.',
  primaryLabel = 'Richiedi una consulenza',
  primaryHref = '/contatti',
  secondaryLabel = `Scrivi a ${site.email}`,
  secondaryHref = `mailto:${site.email}`,
  compact = false,
} = Astro.props;
---

<section class:list={['container-x', compact ? 'py-10' : 'section']}>
  <div class="relative overflow-hidden rounded-3xl border border-amber-500/20 bg-gradient-to-br from-ink-800 via-ink-900 to-ink-950 px-6 py-12 sm:px-12 lg:px-16 lg:py-16">
    <div class="pointer-events-none absolute -top-32 -right-24 h-80 w-80 rounded-full bg-amber-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-20 h-80 w-80 rounded-full bg-beam-500/15 blur-3xl"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="heading-lg">{title}</h2>
        <p class="lead mt-4 max-w-2xl">{description}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
        <a href={primaryHref} class="btn-primary text-base">{primaryLabel}</a>
        <a href={secondaryHref} class="btn-secondary text-base">{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
