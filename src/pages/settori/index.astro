---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { settori } from '../../lib/catalog';

const title = 'Settori di applicazione';
const description = 'Illuminazione professionale per spettacolo, broadcast, teatro, cinema, eventi, mostre e fiere, ENG & streaming e architetturale: prodotti consigliati e consulenza ARTCONTENT in Emilia-Romagna e Marche.';
---

<BaseLayout title={title} description={description}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={[{ label: 'Settori' }]} />
    <SectionHeading as="h1" class="mt-6" eyebrow="Settori" title="Una soluzione per ogni palco, studio e spazio" description="Ogni ambito ha esigenze diverse: resa cromatica per il broadcast, silenziosità per il teatro, IP65 per i tour, dimensioni e design per l’architetturale. Scegli il tuo e scopri la selezione ZAlight." />
  </section>

  <section class="container-x section pt-12">
    <div class="grid gap-6 md:grid-cols-2">
      {
        settori.map((s, i) => (
          <a href={`/settori/${s.slug}`} class="card card-hover group grid overflow-hidden sm:grid-cols-[0.8fr_1.2fr]">
            <div class="relative aspect-[4/3] overflow-hidden bg-ink-700 sm:aspect-auto">
              {s.gallery[0] && <RemoteImage src={s.gallery[0]} alt="" width={560} aspect={4 / 3} fit="cover" priority={i < 2} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" sizes="(min-width:768px) 20vw, 100vw" />}
            </div>
            <div class="flex flex-col p-6">
              <h2 class="font-display text-2xl font-bold text-ink-50">{s.name}</h2>
              <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-300">{s.description[0]}</p>
              <p class="mt-auto pt-4 text-xs font-semibold text-amber-400">{s.count} prodotti consigliati →</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
