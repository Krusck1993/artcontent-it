---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, zalight, territory } from '../config/site';

const title = 'Contatti – richiedi consulenza, demo o preventivo';
const description = `Contatta ${site.name}, agenzia ZAlight per Emilia-Romagna e Marche: consulenza tecnica, demo on-site, preventivi e assistenza su Chauvet Professional, Chauvet DJ, Iluminarc e tutti i brand distribuiti.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  url: new URL('/contatti', site.url).href,
  mainEntity: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={[{ label: 'Contatti' }]} />
  </section>

  <section class="container-x grid gap-12 py-10 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <p class="eyebrow">Contatti</p>
      <h1 class="heading-xl mt-3">Parliamo del tuo <span class="text-gradient-amber">progetto luce</span></h1>
      <p class="lead mt-6">
        Compila il form o chiamaci: ti rispondiamo entro un giorno lavorativo con una proposta concreta, una data per la demo o il preventivo che ti serve.
      </p>

      <dl class="mt-10 space-y-6">
        <div class="flex gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/15 text-amber-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
          </span>
          <div>
            <dt class="text-xs font-semibold tracking-[0.14em] text-ink-300 uppercase">Telefono / WhatsApp</dt>
            <dd class="mt-1 text-lg font-semibold text-ink-50"><a href={site.phoneHref} class="hover:text-amber-400">{site.phone}</a></dd>
            <dd class="text-xs text-ink-300">{site.openingHours} · <a href={site.whatsapp} target="_blank" rel="noopener" class="text-amber-400 hover:underline">Scrivici su WhatsApp</a></dd>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/15 text-amber-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          </span>
          <div>
            <dt class="text-xs font-semibold tracking-[0.14em] text-ink-300 uppercase">Email</dt>
            <dd class="mt-1 text-lg font-semibold text-ink-50"><a href={`mailto:${site.email}`} class="hover:text-amber-400">{site.email}</a></dd>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/15 text-amber-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </span>
          <div>
            <dt class="text-xs font-semibold tracking-[0.14em] text-ink-300 uppercase">Sede</dt>
            <dd class="mt-1 text-ink-50">{site.address.street}, {site.address.zip} {site.address.city} ({site.address.province})</dd>
            <dd class="text-xs text-ink-300">Operiamo in {territory.regions.map((r) => r.name).join(' e ')}: sopralluoghi e demo on-site in tutte le province.</dd>
          </div>
        </div>
      </dl>

      <div class="card mt-10 p-5">
        <p class="text-xs font-semibold tracking-[0.14em] text-ink-300 uppercase">Assistenza tecnica e ricambi</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-200">
          Per pratiche di garanzia e assistenza sui prodotti distribuiti, il centro ufficiale è {zalight.name}:
          <a href={`mailto:${zalight.email}`} class="text-amber-400 hover:underline">{zalight.email}</a> · {zalight.phone}. Se preferisci, apriamo noi la pratica per te.
        </p>
      </div>
    </div>

    <div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
